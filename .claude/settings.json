{
  "autoMemoryDirectory": "~/.ai-lab-sleep/user/agent-memory/_main/ai-lab-sleep-project",
  "permissions": {
    "Read(~/.ai-lab-sleep/**)",
    "Edit(~/.ai-lab-sleep/user/agent-memory/**)",
    "Write(~/.ai-lab-sleep/user/agent-memory/**)",
    "Edit(~/.ai-lab-sleep/user/agents/**)",
    "Edit(~/.ai-lab-sleep/user/scripts/**)",
    "Edit(~/.ai-lab-sleep/user/MEMORY-FORMAT.md)",
    "Edit(~/.ai-lab-sleep/user/dream-state.json)",
    "Write(~/.ai-lab-sleep/user/.dream-phase)",
    "Edit(tests/**)",
    "Write(tests/**)",
    "Edit(findings.md)",
    "Edit(.claude/**)",
    "Edit(scripts/**)",

    "Bash(git pull:*)",
    "Bash(git fetch:*)",
    "Bash(git log:*)",
    "Bash(git status:*)",
    "Bash(git diff:*)",
    "Bash(git rev-parse:*)",
    "Bash(git add:*)",
    "Bash(git mv:*)",
    "Bash(git commit:*)",
    "Bash(git push:*)",
    "Bash(git -C:*)",
    "Bash(git -c:*)",

    "Bash(python3 \"$U/scripts/bet-dossier.py\":*)",
    "Bash(python3 ~/.ai-lab-sleep/user/scripts/bet-dossier.py:*)",
    "Bash(python3 scripts/bet-dossier.py:*)",
    "Bash(\"$U/scripts/notes-ledger.sh\")",
    "Bash(~/.ai-lab-sleep/user/scripts/notes-ledger.sh)",
    "Bash(scripts/notes-ledger.sh)",

    "Bash(grep:*)",
    "Bash(tail:*)",
    "Bash(head:*)",
    "Bash(ls:*)",
    "Bash(cat:*)",
    "Bash(awk:*)",
    "Bash(sed -n:*)",
    "Bash(wc:*)",
    "Bash(date:*)",
    "Bash(echo:*)",
    "Bash(printf:*)",
    "Bash(basename:*)",
    "Bash(mkdir -p tests/results)",
    "Bash(sleep:*)",
    "Bash(rm -f ~/.ai-lab-sleep/user/.dream-phase)",
    "Bash(rm -f \"$SLEEP_HOME/user/.dream-phase\")",
    "Bash(rm -f \"$U/.dream-phase\")"


    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "bash \"$HOME\"/.ai-lab-sleep/user/scripts/scope-guard.sh" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/sleep-bootstrap.sh", "timeout": 120 },
          { "type": "command", "command": "bash \"$HOME\"/.ai-lab-sleep/user/scripts/probe.sh" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$HOME\"/.ai-lab-sleep/user/scripts/probe.sh" },
          { "type": "command", "command": "bash \"$HOME\"/.ai-lab-sleep/user/scripts/ship.sh", "async": true, "timeout": 120 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$HOME\"/.ai-lab-sleep/user/scripts/probe.sh" },
          { "type": "command", "command": "SHIP_DELAY=6 bash \"$HOME\"/.ai-lab-sleep/user/scripts/ship.sh", "async": true, "timeout": 120 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$HOME\"/.ai-lab-sleep/user/scripts/probe.sh" },
          { "type": "command", "command": "SHIP_DELAY=0 bash \"$HOME\"/.ai-lab-sleep/user/scripts/ship.sh", "timeout": 60 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$HOME\"/.ai-lab-sleep/user/scripts/probe.sh", "timeout": 10 },
          { "type": "command", "command": "bash \"$HOME\"/.ai-lab-sleep/user/scripts/ship.sh", "timeout": 50 }
        ]
      }
    ]
  }
}
